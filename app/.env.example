# Copy this file to .env and paste your Anthropic API key to switch on the live AI Detective.
# Without a key the app still works with the built-in offline detective.
ANTHROPIC_API_KEY=
# Optional: choose the model (default claude-opus-5-5)
# DETECTIVE_MODEL=claude-opus-5-5
# Free local AI through Ollama (used automatically when no API key is set and Ollama is running)
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://127.0.0.1:11434
